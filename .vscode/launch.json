{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run client (DEBUG)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_client.py",
      "args": [
        "--host", "127.0.0.1",
        "--port", "4455",
        "--log-level", "DEBUG",
        "--max-blocks", "20"
      ],
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.conda/bin/python"
    },
    {
      "name": "Pytest (protocol)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.conda/bin/python"
    }
  ]
}
